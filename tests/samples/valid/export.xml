      <div type="chapter" n="1" xml:id="P.SAM_1">
        <head type="number" xml:id="P.SAM_1.h1">I.</head>
        <p xml:id="P.SAM_1.p1">Si quis <persName ref="https://example.org/id/person/PERS.7">clericus</persName>
          homicidium fecerit, decem annos paeniteat.<note type="source" source="P.EXE_4">(Exe. 4)</note></p>
