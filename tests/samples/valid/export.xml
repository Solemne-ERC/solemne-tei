      <div type="chapter" n="2" xml:id="P.SAM_2">
        <head type="number" xml:id="P.SAM_2.h1">II.</head>
        <p xml:id="P.SAM_2.p1">Si quis periurium fecerit in <placeName ref="#PLACE.3">ecclesia</placeName>,
          <date when="0816" calendar="#gregorian">anno domini DCCCXVI</date> statutum est ut <foreign xml:lang="grc">ἀναθέμα</foreign>
          sit.</p>
        <p xml:id="P.SAM_2.p2"><choice><sic>paenitead</sic><corr>paeniteat</corr></choice> tres annos.</p>
      </div>
