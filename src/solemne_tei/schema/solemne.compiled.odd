          <desc versionDate="2008-04-05" xml:lang="ja">キビバイト。1024バイト(2の10乗bytes)のこと。</desc>
          <desc versionDate="2008-03-30" xml:lang="fr">2¹⁰ ou 1024 octets</desc>
          <desc versionDate="2007-01-21" xml:lang="it">2¹⁰ or 1024 byte</desc>
