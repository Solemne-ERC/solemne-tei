  <teiHeader><fileDesc>
      <titleStmt>
        <title>Encoding Early Medieval Canon Law: The SOLEMNE Guidelines for TEI</title>
        <author>Gleb Schmidt</author>
        <author>Friederike Voit</author>
        <author>Sven Meeder</author>
      </titleStmt>
      <editionStmt>
