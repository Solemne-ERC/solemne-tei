      <div type="register">
        <div type="registerItem" n="1">
          <head type="number"><pb n="158ra"/>I</head>
          <head type="rubric">De confirmatione caritatis <persName ref="#new_person_god">dei</persName></head>
        </div>
        <div type="registerItem" n="2">
          <head type="number">II</head>
          <head type="rubric">De amore confirmata proximi per <persName ref="#new_person_god">deum</persName></head>
        </div>
        <div type="registerItem" n="3">
          <head type="number">III</head>
          <head type="rubric">De <persName ref="#new_person_god">deo</persName> quod non est personarum
            acceptor</head>
        </div>
        <gap reason="sampling"/>
      </div>
      <div type="section">
        <div type="preface">
          <head type="rubric"><pb n="161r"/>INCIPIT EXCERPTIO SYNODUM.</head>
          <p><persName ref="#new_person_god">Domine et sancte pater patrum</persName>. si quis condemnet excerpentem aut
            condemnet cribantem et limantem stantem in loco sancto. qui legit intellegat dominicam sermocinationem. et
            <bibl ref="#new_bibl_apostolorum">canones sanctorum apostolorum</bibl>. et sanctos uniuersales quinque
            synodos. et eadem in sancto sexto syno<add place="above">do</add> inuenit <eventName
              ref="#new_event_nicaea">niceam</eventName> cum CCCXVIII episcopis. <gap reason="sampling"/></p>
        </div>
        <gap reason="sampling"/>
      </div>
    </body>
