<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC-BY-4.0 -->
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:rng="http://relaxng.org/ns/structure/1.0"
  xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude" xml:lang="en">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>The Solemne TEI schema</title>
        <author>Gleb Schmidt</author>
        <author>Friederike Voit</author>
        <author>Sven Meeder</author>
      </titleStmt>
      <editionStmt>
        <edition n="0.1.0">Version 0.1.0</edition>
      </editionStmt>
      <publicationStmt>
        <publisher>SOLEMNE: The Social Life of Early Medieval Normative Texts, Radboud University</publisher>
        <availability>
          <licence target="https://creativecommons.org/licenses/by/4.0/">This ODD, the guide: CC BY 4.0.</licence>
          <licence target="https://opensource.org/license/mit">The schema generated from it: MIT. It contains
            material of TEI P5 (the TEI Consortium: CC BY 3.0 and BSD 2-Clause) and of the Bodleian Libraries'
            consolidated TEI schema (BSD 2-Clause), and its compiled Schematron the code of SchXslt2 (David Maus,
            MIT): their notices are at the top of each generated file.</licence>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <p>Written for the project, on TEI P5 and the Bodleian's consolidated schema for manuscript
          descriptions.</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <front>
      <xi:include href="chapters/introduction.xml"/>
    </front>
    <body>
      <xi:include href="chapters/what-a-file-describes.xml"/>
      <xi:include href="chapters/file-and-header.xml"/>
      <xi:include href="chapters/text.xml"/>
      <xi:include href="chapters/marked-in-the-text.xml"/>
      <xi:include href="chapters/records.xml"/>
      <xi:include href="chapters/relations.xml"/>
      <xi:include href="chapters/dates.xml"/>
      <xi:include href="chapters/manuscripts.xml"/>
      <xi:include href="chapters/editions-and-literature.xml"/>
      <xi:include href="chapters/exports.xml"/>

      <div>
        <head>The specification</head>
        <schemaSpec ident="solemne" start="TEI" docLang="en" targetLang="en">

          <!-- The modules, and the elements taken from each. -->
          <moduleRef key="tei"/>
          <moduleRef key="core"
            include="abbr add addrLine address analytic author bibl biblScope biblStruct choice cit citedRange corr
              date del desc editor email expan foreign gap graphic head imprint item label lb list listBibl measure
              monogr name note num orig p pb postCode ptr publisher pubPlace q quote ref reg resp respStmt rs series sic
              street term textLang title unclear"/>
          <moduleRef key="header"
            include="abstract authority availability catDesc category change citeData citeStructure classDecl
              correction creation distributor edition editionStmt editorialDecl encodingDesc extent fileDesc funder
              handNote idno interpretation keywords langUsage language licence listChange listPrefixDef normalization
              notesStmt prefixDef principal profileDesc projectDesc publicationStmt punctuation quotation refsDecl
              revisionDesc
              samplingDecl scriptNote segmentation seriesStmt sourceDesc sponsor stdVals taxonomy teiHeader
              textClass titleStmt typeNote"/>
          <moduleRef key="textstructure" include="TEI body div text"/>
          <moduleRef key="namesdates"
            include="addName affiliation birth bloc country death district event eventName floruit forename genName
              geo geogName listEvent listOrg listPerson listPlace listRelation location nameLink occupation org
              orgName persName person place placeName region relation roleName settlement surname"/>
          <!-- Manuscript descriptions follow the Bodleian's consolidated schema: the build compiles its ODD and puts
               it next to this one under this name. -->
          <moduleRef key="msdescription" source="msdesc.compiled.odd"/>
          <moduleRef key="linking" include="anchor annotation link linkGrp listAnnotation seg standOff"/>
          <moduleRef key="transcr" include="subst supplied"/>
          <moduleRef key="textcrit" include="listWit witness"/>

          <!-- Each part's specifications, in the parts' order. -->
          <specGrpRef target="#file-and-header-specs"/>
          <specGrpRef target="#text-specs"/>
          <specGrpRef target="#marked-in-the-text-specs"/>
          <specGrpRef target="#records-specs"/>
          <specGrpRef target="#relations-specs"/>
          <specGrpRef target="#dates-specs"/>
          <specGrpRef target="#manuscripts-specs"/>

        </schemaSpec>
      </div>
    </body>
  </text>
</TEI>
