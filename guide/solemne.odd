<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC-BY-4.0 -->
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:rng="http://relaxng.org/ns/structure/1.0"
  xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:xi="http://www.w3.org/2001/XInclude" xml:lang="en">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>The Solemne TEI schema</title>
        <author>Gleb Schmidt</author>
        <author>Friederike Voit</author>
        <author>Sven Meeder</author>
      </titleStmt>
      <editionStmt>
        <edition n="0.2.0">Version 0.2.0</edition>
      </editionStmt>
      <publicationStmt>
        <publisher>SOLEMNE: The Social Life of Early Medieval Normative Texts, Radboud University</publisher>
        <availability>
          <licence target="https://creativecommons.org/licenses/by/4.0/">This ODD, the guide: CC BY 4.0.</licence>
          <licence target="https://opensource.org/license/mit">The schema generated from it: MIT. It contains
            material of TEI P5 (the TEI Consortium: CC BY 3.0 and BSD 2-Clause) and of the Bodleian Libraries'
            consolidated TEI schema (BSD 2-Clause), and its compiled Schematron the code of SchXslt2 (David Maus,
            MIT): their notices are at the top of each generated file.</licence>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <p>Written for the project, on TEI P5 and the Bodleian's consolidated schema for manuscript
          descriptions.</p>
      </sourceDesc>
    </fileDesc>
    <encodingDesc>
      <classDecl>
        <taxonomy xml:id="tiers">
          <desc>The tiers: how far a file goes, from a minimal file to the full encoding. Every element, attribute
            and rule of the schema belongs to one tier, named by <att>corresp</att> on its specification, or, for an
            element taken from TEI unchanged, by the table of elements beside the specification.</desc>
          <category xml:id="tier-required">
            <catDesc><term>required</term>: what every file has. A file without it fails the checks: the import
              refuses a file that fails the RelaxNG, and reports the Schematron's errors, such as a formal title
              without the document's code.</catDesc>
          </category>
          <category xml:id="tier-common">
            <catDesc><term>common</term>: what most encoders add, as most of the project's coded files
              do.</catDesc>
          </category>
          <category xml:id="tier-full">
            <catDesc><term>full</term>: every other claim about the text, its source or the world, at full depth,
              signed and with its evidence.</catDesc>
          </category>
          <category xml:id="tier-export-only">
            <catDesc><term>export only</term>: the application's own state, which only its exports write, so that
              anyone can read them.</catDesc>
          </category>
        </taxonomy>
      </classDecl>
    </encodingDesc>
  </teiHeader>
  <text>
    <front>
      <xi:include href="chapters/introduction.xml"/>
    </front>
    <body>
      <xi:include href="chapters/what-a-file-describes.xml"/>
      <xi:include href="chapters/file-and-header.xml"/>
      <xi:include href="chapters/text.xml"/>
      <xi:include href="chapters/marked-in-the-text.xml"/>
      <xi:include href="chapters/records.xml"/>
      <xi:include href="chapters/relations.xml"/>
      <xi:include href="chapters/dates.xml"/>
      <xi:include href="chapters/manuscripts.xml"/>
      <xi:include href="chapters/editions-and-literature.xml"/>
      <xi:include href="chapters/exports.xml"/>

      <div xml:id="specification">
        <head>The specification</head>
        <p>The schema takes the modules of TEI below, and from each only the elements listed: an element outside
          them fails the RelaxNG. Each part's specifications follow, in the parts' order. An element the
          specifications change carries its tier there; the others take theirs from this table.</p>
        <table xml:id="element-tiers">
          <head>The elements taken from TEI unchanged, by tier</head>
          <row role="label">
            <cell>Tier</cell>
            <cell>Elements</cell>
          </row>
          <row corresp="#tier-required">
            <cell>required</cell>
            <cell>
              <gi>fileDesc</gi> <gi>publicationStmt</gi> <gi>sourceDesc</gi> <gi>TEI</gi> <gi>text</gi>
            </cell>
          </row>
          <row corresp="#tier-common">
            <cell>common</cell>
            <cell>
              <gi>address</gi> <gi>analytic</gi> <gi>biblScope</gi> <gi>biblStruct</gi>
              <gi>distributor</gi> <gi>email</gi> <gi>forename</gi> <gi>imprint</gi> <gi>listPerson</gi>
              <gi>monogr</gi> <gi>p</gi> <gi>postCode</gi> <gi>publisher</gi> <gi>pubPlace</gi>
              <gi>series</gi> <gi>standOff</gi> <gi>street</gi> <gi>surname</gi>
            </cell>
          </row>
          <row corresp="#tier-full">
            <cell>full</cell>
            <cell>
              <gi>abbr</gi> <gi>abstract</gi> <gi>accMat</gi> <gi>acquisition</gi> <gi>add</gi>
              <gi>additional</gi> <gi>additions</gi> <gi>addName</gi> <gi>addrLine</gi>
              <gi>adminInfo</gi> <gi>affiliation</gi> <gi>altIdentifier</gi> <gi>anchor</gi>
              <gi>annotation</gi> <gi>authority</gi> <gi>availability</gi> <gi>binding</gi>
              <gi>bindingDesc</gi> <gi>birth</gi> <gi>bloc</gi> <gi>calendarDesc</gi>
              <gi>catchwords</gi> <gi>catDesc</gi>
              <gi>category</gi> <gi>change</gi> <gi>choice</gi> <gi>cit</gi> <gi>citedRange</gi>
              <gi>classDecl</gi> <gi>collation</gi> <gi>collection</gi> <gi>colophon</gi>
              <gi>condition</gi> <gi>corr</gi> <gi>correction</gi> <gi>creation</gi> <gi>custEvent</gi>
              <gi>custodialHist</gi> <gi>death</gi> <gi>decoDesc</gi> <gi>decoNote</gi> <gi>del</gi>
              <gi>depth</gi> <gi>desc</gi> <gi>dim</gi> <gi>dimensions</gi> <gi>district</gi>
              <gi>edition</gi> <gi>editionStmt</gi> <gi>encodingDesc</gi> <gi>expan</gi>
              <gi>explicit</gi> <gi>extent</gi> <gi>filiation</gi> <gi>finalRubric</gi>
              <gi>foliation</gi> <gi>foreign</gi> <gi>funder</gi> <gi>genName</gi> <gi>geo</gi>
              <gi>geogName</gi> <gi>graphic</gi> <gi>handDesc</gi> <gi>handNote</gi> <gi>height</gi>
              <gi>heraldry</gi> <gi>history</gi> <gi>incipit</gi> <gi>interpretation</gi> <gi>item</gi>
              <gi>keywords</gi> <gi>label</gi> <gi>language</gi> <gi>langUsage</gi> <gi>layout</gi>
              <gi>layoutDesc</gi> <gi>lb</gi> <gi>licence</gi> <gi>list</gi> <gi>listAnnotation</gi>
              <gi>listBibl</gi> <gi>listChange</gi> <gi>listEvent</gi> <gi>listOrg</gi>
              <gi>listPlace</gi> <gi>listPrefixDef</gi> <gi>listRelation</gi> <gi>listWit</gi>
              <gi>location</gi> <gi>locus</gi> <gi>locusGrp</gi> <gi>material</gi> <gi>measure</gi>
              <gi>msContents</gi> <gi>msFrag</gi> <gi>msIdentifier</gi> <gi>msItem</gi>
              <gi>msItemStruct</gi> <gi>msName</gi> <gi>msPart</gi> <gi>musicNotation</gi> <gi>name</gi>
              <gi>nameLink</gi> <gi>normalization</gi> <gi>notesStmt</gi> <gi>num</gi>
              <gi>objectDesc</gi> <gi>objectType</gi> <gi>occupation</gi> <gi>org</gi> <gi>orig</gi>
              <gi>origin</gi> <gi>physDesc</gi> <gi>place</gi> <gi>principal</gi>
              <gi>profileDesc</gi> <gi>projectDesc</gi> <gi>provenance</gi> <gi>ptr</gi>
              <gi>punctuation</gi> <gi>q</gi> <gi>quotation</gi> <gi>recordHist</gi> <gi>refsDecl</gi>
              <gi>reg</gi> <gi>resp</gi> <gi>respStmt</gi> <gi>revisionDesc</gi> <gi>roleName</gi>
              <gi>rubric</gi> <gi>samplingDecl</gi> <gi>scriptDesc</gi> <gi>scriptNote</gi>
              <gi>seal</gi> <gi>sealDesc</gi> <gi>secFol</gi> <gi>seriesStmt</gi> <gi>sic</gi>
              <gi>signatures</gi> <gi>source</gi> <gi>sponsor</gi> <gi>stamp</gi> <gi>stdVals</gi>
              <gi>subst</gi> <gi>summary</gi> <gi>supplied</gi> <gi>support</gi> <gi>supportDesc</gi>
              <gi>surrogates</gi> <gi>taxonomy</gi> <gi>term</gi> <gi>textClass</gi> <gi>textLang</gi>
              <gi>typeDesc</gi> <gi>typeNote</gi> <gi>unclear</gi> <gi>watermark</gi> <gi>width</gi>
              <gi>witness</gi>
            </cell>
          </row>
          <row corresp="#tier-export-only">
            <cell>export only</cell>
            <cell>
              <gi>citeData</gi> <gi>citeStructure</gi> <gi>link</gi> <gi>linkGrp</gi>
            </cell>
          </row>
        </table>
        <schemaSpec ident="solemne" start="TEI" docLang="en" targetLang="en" xml:id="element-outside-the-schema"
          corresp="#tier-required">

          <!-- The modules, and the elements taken from each. -->
          <moduleRef key="tei"/>
          <moduleRef key="core"
            include="abbr add addrLine address analytic author bibl biblScope biblStruct choice cit citedRange corr
              date del desc editor email expan foreign gap graphic head imprint item label lb list listBibl measure
              monogr name note num orig p pb postCode ptr publisher pubPlace q quote ref reg resp respStmt rs series sic
              street term textLang title unclear"/>
          <moduleRef key="header"
            include="abstract authority availability calendar calendarDesc catDesc category change citeData
              citeStructure classDecl correction creation distributor edition editionStmt editorialDecl encodingDesc
              extent fileDesc funder handNote idno interpretation keywords langUsage language licence listChange listPrefixDef normalization
              notesStmt prefixDef principal profileDesc projectDesc publicationStmt punctuation quotation refsDecl
              revisionDesc
              samplingDecl scriptNote segmentation seriesStmt sourceDesc sponsor stdVals taxonomy teiHeader
              textClass titleStmt typeNote"/>
          <moduleRef key="textstructure" include="TEI body div text"/>
          <moduleRef key="namesdates"
            include="addName affiliation birth bloc country death district event eventName floruit forename genName
              geo geogName listEvent listOrg listPerson listPlace listRelation location nameLink occupation org
              orgName persName person place placeName region relation roleName settlement surname"/>
          <!-- Manuscript descriptions follow the Bodleian's consolidated schema: the build compiles its ODD and puts
               it next to this one under this name. -->
          <moduleRef key="msdescription" source="msdesc.compiled.odd"/>
          <moduleRef key="linking" include="anchor annotation link linkGrp listAnnotation seg standOff"/>
          <moduleRef key="transcr" include="subst supplied"/>
          <moduleRef key="textcrit" include="listWit witness"/>

          <!-- Each part's specifications, in the parts' order. -->
          <specGrpRef target="#header-title-specs"/>
          <specGrpRef target="#header-pointers-specs"/>
          <specGrpRef target="#header-encoding-specs"/>
          <specGrpRef target="#header-external-ids-specs"/>
          <specGrpRef target="#text-divisions-specs"/>
          <specGrpRef target="#text-headings-specs"/>
          <specGrpRef target="#text-page-breaks-specs"/>
          <specGrpRef target="#text-gaps-specs"/>
          <specGrpRef target="#marked-names-specs"/>
          <specGrpRef target="#marked-works-specs"/>
          <specGrpRef target="#marked-statements-specs"/>
          <specGrpRef target="#marked-pointers-specs"/>
          <specGrpRef target="#marked-notes-specs"/>
          <specGrpRef target="#marked-other-specs"/>
          <specGrpRef target="#records-specs"/>
          <specGrpRef target="#relations-specs"/>
          <specGrpRef target="#dates-form-specs"/>
          <specGrpRef target="#dates-calendars-specs"/>
          <specGrpRef target="#dates-specs"/>
          <specGrpRef target="#manuscripts-specs"/>

        </schemaSpec>
      </div>
    </body>
    <back>
      <!-- solemne-tei docs generates the appendices in place of these placeholders, from the specifications. -->
      <divGen xml:id="appendix-elements" type="elements">
        <head>The elements and attributes</head>
      </divGen>
      <divGen xml:id="appendix-rules" type="rules">
        <head>The rules</head>
      </divGen>
      <div xml:id="example-sources">
        <head>The sources of the examples</head>
        <p>The guide's examples quote short excerpts of the project's corpus, cut where the point is made and revised to
          the forms this guide decides; marks that don't concern the point may be left out. Each example names its
          file here, by
          <att>source</att>: the file's code, the text, and the edition or the manuscript it was transcribed from. An
          example without a source is made up, where the corpus has nothing to show, and so are the
          counter-examples.</p>
        <listBibl>
          <bibl xml:id="source-C.AAC-0816"><idno>C.AAC-0816</idno>: <title>Council of Aachen, 816</title>, ed.
            <editor>Albert Werminghoff</editor>, <title>Concilia aevi Karolini</title> I, MGH Concilia 2.1 (Hannover
            and Leipzig, <date>1906</date>), pp. 307–464.</bibl>
          <bibl xml:id="source-C.AAC-0836"><idno>C.AAC-0836</idno>: <title>Council of Aachen, 836</title>, ed.
            <editor>Albert Werminghoff</editor>, <title>Concilia aevi Karolini</title> II, MGH Concilia 2.2 (Hannover
            and Leipzig, <date>1908</date>), pp. 704–767.</bibl>
          <bibl xml:id="source-C.ASC-0756"><idno>C.ASC-0756</idno>: <title>Council of Aschheim, 756 or
              755–760</title>, ed. <editor>Albert Werminghoff</editor>, <title>Concilia aevi Karolini</title> I, MGH
            Concilia 2.1 (Hannover and Leipzig, <date>1906</date>), pp. 56–58.</bibl>
          <bibl xml:id="source-C.CAR-0397"><idno>C.CAR-0397</idno>: <title>Council of Carthage, 397</title>, ed.
            <editor>Charles Munier</editor>, <title>Concilia Africae a. 345 – a. 525</title>, CCSL 149 (Turnhout,
            <date>1974</date>), pp. 326–341: the file's header and the records of its standOff, the project's
            own.</bibl>
          <bibl xml:id="source-C.MAI-0813"><idno>C.MAI-0813</idno>: <title>Council of Mainz, 813</title>, ed.
            <editor>Albert Werminghoff</editor>, <title>Concilia aevi Karolini</title> I, MGH Concilia 2.1 (Hannover
            and Leipzig, <date>1906</date>), pp. 258–273.</bibl>
          <bibl xml:id="source-C.ROM-0826"><idno>C.ROM-0826</idno>: <title>Council of Rome, 826</title>, ed.
            <editor>Albert Werminghoff</editor>, <title>Concilia aevi Karolini</title> II, MGH Concilia 2.2 (Hannover
            and Leipzig, <date>1908</date>), pp. 552–583.</bibl>
          <bibl xml:id="source-C.SOI-0744"><idno>C.SOI-0744</idno>: <title>Council of Soissons, 744</title>, ed.
            <editor>Albert Werminghoff</editor>, <title>Concilia aevi Karolini</title> I, MGH Concilia 2.1 (Hannover
            and Leipzig, <date>1906</date>), pp. 33–36.</bibl>
          <bibl xml:id="source-C.VLA-0549"><idno>C.VLA-0549</idno>: <title>Council of Valencia, 549</title>, ed.
            <editor>José Vives</editor>, <title>Concilios visigóticos e hispano-romanos</title>, España Cristiana 1
            (Barcelona and Madrid, <date>1963</date>), pp. 61–64.</bibl>
          <bibl xml:id="source-COLL.400.ms-Mun-BSB-4592"><idno>COLL.400.ms-Mun-BSB-4592</idno>: <title>Collectio 400
              capitulorum</title>, transcribed by the project from Munich, Bayerische Staatsbibliothek, Clm
            4592.</bibl>
          <bibl xml:id="source-COLL.Dach"><idno>COLL.Dach</idno>: <title>Collectio Dacheriana</title>, ed.
            <editor>Luc d'Achery</editor>, <title>Spicilegium</title>, vol. 11 (Paris, <date>1723</date>),
            pp. 1–200.</bibl>
          <bibl xml:id="source-COLL.Ans.ms-Par-BnF-15392"><idno>COLL.Ans.ms-Par-BnF-15392</idno>: <title>Collectio
              Anselmo dedicata</title> in Paris, Bibliothèque nationale de France, lat. 15392: the file's description
            of the manuscript.</bibl>
          <bibl xml:id="source-COLL.Dach.ms-Brn-Burg-425"><idno>COLL.Dach.ms-Brn-Burg-425</idno>: <title>Collectio
              Dacheriana</title> in Bern, Burgerbibliothek, 425: the file's description of the manuscript.</bibl>
          <bibl xml:id="source-COLL.His.ms-Vat-BAV-Pal575"><idno>COLL.His.ms-Vat-BAV-Pal575</idno>: <title>Collectio
              Hispana</title> in Vatican City, Biblioteca Apostolica Vaticana, Pal. lat. 575: the file's description
            of the manuscript.</bibl>
          <bibl xml:id="source-COLL.Laur.ms-Vat-BAV-Pal574"><idno>COLL.Laur.ms-Vat-BAV-Pal574</idno>:
            <title>Collectio Laureshamensis</title> in Vatican City, Biblioteca Apostolica Vaticana, Pal. lat. 574:
            the file's description of the manuscript.</bibl>
        </listBibl>
      </div>
    </back>
  </text>
</TEI>
